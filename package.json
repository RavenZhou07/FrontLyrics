{
  "name": "lyricglass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc --noEmit && vite build",
    "build": "tauri build",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "vitest run",
    "check": "tsc --noEmit && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "probe:smtc": "cargo run --manifest-path src-tauri/Cargo.toml --example smtc_probe",
    "probe:lyrics": "cargo run --manifest-path src-tauri/Cargo.toml --example lyrics_probe",
    "format": "prettier --write src themes package.json tsconfig.json vite.config.ts src-tauri/tauri.conf.json && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
